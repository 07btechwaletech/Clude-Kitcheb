---
import Base from '../layouts/Base.astro';
import WhatsAppIcon from '../components/WhatsAppIcon';
import { SITE } from '../lib/site';
import { hello } from '../lib/docket';
---

<Base
  title="Page not found"
  description={`That page is not on the ${SITE.name} site. The menu, the gallery and the kitchen's number are all one tap away.`}
>
  <section class="grid min-h-[60vh] place-items-center py-sec">
    <div class="wrap max-w-[46rem] text-center">
      <p class="eyebrow mb-6 justify-center">Ticket 404 · not on the pass</p>
      <h1 class="text-h2">We could not find that one</h1>
      <p class="lede mx-auto mt-5">
        The page has moved or never existed. The food, happily, is still right here.
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a class="btn" href="/menu">See the menu</a>
        <a class="btn btn-ghost" href="/">Back to the kitchen</a>
        <a class="btn btn-wa" href={hello} target="_blank" rel="noopener noreferrer">
          <WhatsAppIcon className="h-[1.1em] w-[1.1em]" />
          Order on WhatsApp
        </a>
      </div>
    </div>
  </section>
</Base>
